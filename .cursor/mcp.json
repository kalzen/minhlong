{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "canva-dev": {
            "command": "npx",
            "args": [
                "-y",
                "@canva/cli@latest",
                "mcp"
            ]
        }
    }
}